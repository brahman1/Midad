{
  "name": "midad",
  "private": true,
  "workspaces": [
    "api",
    "web",
    "mobile",
    "shared"
  ],
  "scripts": {
    "dev:api": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "dev:mobile": "npm run start -w mobile",
    "build": "npm run build -w shared && npm run build -w api && npm run build -w web",
    "check": "npm run check -w shared && npm run check -w api && npm run check -w web && npm run check -w mobile",
    "test": "node --test tests/*.test.mjs",
    "demo": "node scripts/demo.mjs && node scripts/demo-showcase.mjs",
    "leads": "node scripts/leads.mjs",
    "format": "prettier --write \"{api,web,mobile,shared,tests,scripts}/**/*.{ts,tsx,mjs,json,css}\"",
    "format:check": "prettier --check \"{api,web,mobile,shared,tests,scripts}/**/*.{ts,tsx,mjs,json,css}\"",
    "start:api": "npm run start -w api",
    "start:web": "node scripts/serve-web.mjs",
    "preview:mobile": "node scripts/preview-mobile.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
