DATABASE_URL=postgresql://midad:midad_local_only@127.0.0.1:5438/midad
PORT=4100
WEB_URL=http://127.0.0.1:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:8085
NODE_ENV=development
SMTP_HOST=127.0.0.1
SMTP_PORT=1028
SMTP_FROM=Midad <contact@localhost>
SMTP_USER=
SMTP_PASSWORD=
NEXT_PUBLIC_API_URL=/api
API_INTERNAL_URL=http://127.0.0.1:4100
# Pour un téléphone sur le réseau local, définir dans mobile/.env.local :
# EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:4100/api
# EXPO_PUBLIC_WEB_URL=http://YOUR_LAN_IP:3000
# Sinon Expo déduit l’adresse de la machine de développement.
EXPO_PUBLIC_EAS_PROJECT_ID=
# Secret serveur aléatoire (32 caractères minimum), jamais dans EXPO_PUBLIC/NEXT_PUBLIC.
# Générer avec node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SECURITY_ENCRYPTION_KEY=
